{
  "name": "@konnec/vue-eloquent",
  "version": "1.8.0",
  "author": "Christian D'Aquino",
  "license": "MIT",
  "keywords": [
    "Vue",
    "Laravel",
    "Api",
    "Eloquent",
    "ORM",
    "Model",
    "Validation",
    "Broadcast",
    "Vuelidate",
    "Echo",
    "DevTools"
  ],
  "description": "An interface for Vue and Laravel Eloquent through API",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --coverage.enabled=true",
    "test:unit:ui": "vitest --ui --coverage.enabled=true --api 9527",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.json --composite false",
    "lint": "eslint -c ./eslint.config.js --fix \"./src*/**/*.{ts,js,cjs,mjs,vue}\""
  },
  "dependencies": {
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.20.0",
    "laravel-echo": "^2.5.0",
    "lodash": "^4.18.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.3",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "pusher-js": "^8.6.0",
    "pusher-js-mock": "^0.3.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-eloquent.umd.cjs",
  "module": "./dist/vue-eloquent.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-eloquent.js",
      "require": "./dist/vue-eloquent.umd.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cimd/vue-eloquent.git"
  },
  "nyc": {
    "reporter": [
      "lcov"
    ]
  },
  "bugs": {
    "url": "https://github.com/cimd/vue-eloquent/issues"
  },
  "homepage": "https://vue-eloquent.netlify.app"
}
